{
  "name": "localant",
  "version": "1.4.9",
  "private": false,
  "description": "LocalAnt — Use ChatGPT as the brain and your local computer as the hands. A safe, permissioned local MCP Gateway for ChatGPT.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yuga-hashimoto/localant.git"
  },
  "homepage": "https://github.com/yuga-hashimoto/localant#readme",
  "bugs": {
    "url": "https://github.com/yuga-hashimoto/localant/issues"
  },
  "type": "module",
  "bin": {
    "localant": "packages/cli/dist/bin.js"
  },
  "files": [
    "packages/*/dist/**",
    "packages/*/package.json",
    "examples/skills/**",
    "assets/**",
    "scripts/postinstall.mjs",
    "README.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.10"
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean && rimraf packages/*/dist",
    "dev": "tsc -b --watch",
    "typecheck": "tsc -b --noEmit false",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "validate": "pnpm build && pnpm test",
    "start": "node packages/cli/dist/bin.js start",
    "setup": "node packages/cli/dist/bin.js setup",
    "postinstall": "node scripts/postinstall.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "commander": "^15.0.0",
    "express": "^5.0.1",
    "nanoid": "^5.0.9",
    "tsx": "^4.19.2",
    "zod": "^4.4.3"
  },
  "keywords": [
    "chatgpt",
    "mcp",
    "model-context-protocol",
    "local-first",
    "gateway",
    "skills",
    "claude-code",
    "codex",
    "automation",
    "openclaw",
    "localant"
  ],
  "devDependencies": {
    "@localant/gateway": "workspace:*",
    "@localant/mcp": "workspace:*",
    "@localant/shared": "workspace:*",
    "@localant/skill-sdk": "workspace:*",
    "@types/express": "^5.0.0",
    "@types/node": "^25.9.3",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "@vitest/coverage-v8": "^4.1.9",
    "eslint": "^10.5.0",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "packageManager": "pnpm@11.5.1"
}
